# Copy thanh .env chi khi chay local, KHONG commit .env that.
# Tren Coolify: nhap cac bien nay o muc Environment Variables cua app, khong dua vao repo.
DATABASE_URL=postgres://epaper_app:DOI_MAT_KHAU_MOI@<host-postgres>:5432/epaper_phase1
PORT=3000
STORAGE_DIR=/app/storage

# --- Goi 2D-2: chuan bi AD/LDAP (de trong = tat, dang nhap Local/JWT chay nhu cu) ---
# AUTH_LDAP_URL=
# AUTH_LDAP_BIND_DN=
# AUTH_LDAP_BIND_PASSWORD=
# AUTH_LDAP_SEARCH_BASE=
# AUTH_LDAP_SEARCH_FILTER=
# AUTH_LDAP_USERNAME_ATTRIBUTE=

# --- Goi 2D-3: Facebook (Meta App cua toa soan; de trong = CMS bao "chua cau hinh") ---
# FB_APP_ID=
# FB_APP_SECRET=
# FB_REDIRECT_URI=https://vtcany-api.vtctech.xyz/api/v1/admin/distribution/facebook/callback
# FB_PAGE_ID= (tuy chon: khoa dung 1 Page khi tai khoan quan ly nhieu Page)
# PUBLIC_MEDIA_BASE_URL= (tuy chon: origin cong khai cua media, mac dinh lay theo VOD_PUBLIC_BASE_URL/FB_REDIRECT_URI)
